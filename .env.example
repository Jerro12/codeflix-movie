# ===========================================
# CODEFLIX - Environment Configuration Example
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# php artisan key:generate

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="Codeflix"
APP_ENV=local                    # local, staging, production
APP_KEY=                         # Run: php artisan key:generate
APP_DEBUG=true                   # Set to false in production!
APP_TIMEZONE=Asia/Jakarta        # Your timezone
APP_URL=http://localhost:8000    # Your app URL (include port if needed)

# Localization
APP_LOCALE=id                    # id, en, etc
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file

# Performance
PHP_CLI_SERVER_WORKERS=4         # Number of workers for artisan serve
BCRYPT_ROUNDS=12                 # Password hashing rounds (10-12 recommended)

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=stack                # stack, single, daily, slack, etc
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                  # emergency, alert, critical, error, warning, notice, info, debug

# ===========================================
# DATABASE
# ===========================================
# MySQL (Recommended for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=codeflix             # Your database name
DB_USERNAME=root                 # Your database username
DB_PASSWORD=                     # Your database password (leave empty if none)
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# PostgreSQL Alternative:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=codeflix
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# ===========================================
# SESSION & COOKIES
# ===========================================
# ===========================================
# SESSION & COOKIES
# ===========================================
SESSION_DRIVER=redis             # file, database, redis, cookie, array
SESSION_LIFETIME=120             # Minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null              # Set to .yourdomain.com for subdomains
SESSION_SECURE_COOKIE=false      # Set to true for HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax            # strict, lax, none
SESSION_CONNECTION=default

# ===========================================
# CACHE, QUEUE & BROADCAST
# ===========================================
BROADCAST_CONNECTION=log         # pusher, redis, log, null
FILESYSTEM_DISK=s3               # local, s3, public
QUEUE_CONNECTION=redis           # sync, database, redis, sqs

# Cache Driver
CACHE_STORE=redis                # file, database, redis, memcached
CACHE_PREFIX=codeflix_

# ===========================================
# REDIS (Optional - for better performance)
# ===========================================
REDIS_CLIENT=predis              # phpredis, predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=                  # Set if Redis requires password

REDIS_PORT=6379

# ===========================================
# MAIL
# ===========================================
# Mailpit for local development (FlyEnv)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# For Mailtrap (testing)
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS="noreply@codeflix.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# MINIO / AWS S3 (Object Storage)
# ===========================================
# Minio for local development (FlyEnv)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=codeflix
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# AWS S3 for production:
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=codeflix-storage
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# SANCTUM (API Authentication)
# ===========================================
# Domains that can make stateful API requests
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:8000

# ===========================================
# MIDTRANS PAYMENT GATEWAY
# ===========================================
# Get your keys from: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false     # Set to true for production
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ===========================================
# CODEFLIX SETTINGS
# ===========================================
# Customer service / default phone
DEFAULT_PHONE=08xxxxxxxxxx

# Maximum profiles per user account (like Netflix)
MAX_PROFILES_PER_USER=5

# Referral system - bonus days when referred user subscribes
REFERRAL_BONUS_DAYS=7

# ===========================================
# VITE (Frontend Build)
# ===========================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
